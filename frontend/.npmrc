# Some registry mirrors (e.g. registry.npmmirror.com) don't serve the
# npm attestations API pnpm checks by default — every package then retries
# against an endpoint that will never respond, making `pnpm install` take
# many minutes instead of seconds. This has nothing to do with package
# integrity (pnpm still verifies checksums); it only skips the optional
# supply-chain provenance check.
verify-signatures=false
