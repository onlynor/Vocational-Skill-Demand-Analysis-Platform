# 复制本文件为 .env（gitignore 已忽略 .env），填入真实值后再启动后端
# cp .env.example .env

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=job_analysis

# development：跳过下面的生产安全检查（本地调试用）
# production（默认，不写这行时的兜底值）：SECRET_KEY 若缺失或仍是占位符，启动时直接报错拒绝运行
ENV=development

# 生产前用：openssl rand -hex 32 生成强密钥替换下面占位符；
# ENV=production 时如果这里还留着占位符，后端会拒绝启动
SECRET_KEY=dev-secret-key-change-in-production

# 允许跨域访问的前端源，逗号分隔，例如：
# CORS_ORIGINS=https://example.com,https://www.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173